{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DepRadar",
  "mainBinaryName": "depradar",
  "identifier": "com.sikander.depradar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DepRadar",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCMUMwRjc3RkU2MkJDNEQKUldSTnZHTCtkdzhjRzdpbWl6Rk5ELzlmc2pUaXZNMHZkL2lwTmd1Zkk5a3QrUnRwek9oa3VqalcK",
      "endpoints": [
        "https://github.com/depradar-app/depradar/releases/latest/download/latest.json"
      ]
    }
  }
}
